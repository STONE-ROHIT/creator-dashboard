# ============================================================
# Creator Dashboard — Server Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# ── Node Environment ─────────────────────────────────────────
NODE_ENV=development          # development | production
PORT=5000

# ── Database ─────────────────────────────────────────────────
# Option A: Individual params (local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=creator_dashboard
DB_USER=postgres
DB_PASSWORD=your_password_here

# Option B: Connection string (cloud — Railway, Neon, Supabase)
# If DATABASE_URL is set, it takes priority over individual params above
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── JWT ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_at_least_64_chars

# ── Razorpay ─────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
# Use test keys for development, live keys for production
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Webhook secret — get from: https://dashboard.razorpay.com/app/webhooks
# Create a webhook pointing to: https://YOUR_DOMAIN/api/payments/webhook
# Events to select: payment.authorized
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Leave blank for development (allows all origins)
# Example for production: https://your-app.vercel.app
CORS_ORIGIN=http://localhost:3000
